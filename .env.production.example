# Copy to /opt/cs2match/.env.production on the server and chmod 600 it.
# Every placeholder must be replaced. Never commit the real file.

COMPOSE_PROJECT_NAME=cs2match-prod

# Immutable image references. BACKEND_IMAGE_REF must include @sha256:...
BACKEND_IMAGE_REF=ghcr.io/owner/cs2match-nakama@sha256:REPLACE_ME
POSTGRES_IMAGE=postgres:15.18-alpine
CLOUDFLARED_IMAGE_REF=cloudflare/cloudflared:2026.7.2@sha256:4f6655284ab3d252b7f28fedb19fe6c8fc82ee5b1295c20ac74d475e5398a52d
RESTIC_IMAGE=restic/restic:0.18.0

DB_NAME=nakama
DB_USER=nakama
DB_PASSWORD=REPLACE_WITH_HEX_PASSWORD

# The server key is embedded in the browser and is not a secret boundary.
NAKAMA_SERVER_KEY=REPLACE_WITH_UNIQUE_SERVER_KEY
CONSOLE_USERNAME=cs2operator
CONSOLE_PASSWORD=REPLACE_WITH_CONSOLE_PASSWORD
CONSOLE_SIGNING_KEY=REPLACE_WITH_DIFFERENT_CONSOLE_SIGNING_KEY
SESSION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
SESSION_REFRESH_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARS
RUNTIME_HTTP_KEY=REPLACE_WITH_DIFFERENT_RUNTIME_KEY

API_HOST=api.example.com
FRONTEND_ORIGIN=https://play.example.com
TAILSCALE_IP=100.64.0.10
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET_NAME
RESTIC_PASSWORD=REPLACE_WITH_RESTIC_REPOSITORY_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
